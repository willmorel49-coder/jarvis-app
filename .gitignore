# ═══════════════════════════════════════════════
# JARVIS APP — .gitignore (hardened 2026-06-03)
# ═══════════════════════════════════════════════

# ── OS / éditeur ─────────────────────────────
.DS_Store
*.log
.vscode/
.idea/

# ── Secrets & env ────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
secrets/
secret*
credentials*
tokens.json
tokens*.json
*-credentials.json
service_role*
SERVICE_ROLE*

# ── Robot-Memory / Claude locale ─────────────
ROBOT.local.md
CLAUDE.local.md
.claude/cache/
.claude/.tmp/
.superpowers/

# ── Caches scrapers / API externes ───────────
cache_*.json
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Fichiers temporaires Office ──────────────
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

