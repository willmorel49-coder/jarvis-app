# =============================================================================
# .env.example — variables d'environnement pour Intégral Pharma / JARVIS
# =============================================================================
# Ce fichier sert de modèle. Ne PAS commiter de vraies clés ici.
#
# Pour l'app web (vanilla JS sur GitHub Pages), aucune clé n'est lue côté
# navigateur — Supabase est la seule source serveur. Ces variables sont
# destinées aux Supabase Edge Functions (Deno).
#
# DÉPLOIEMENT côté Supabase (production) :
#   supabase secrets set GOOGLE_API_KEY=xxx --project-ref iyvavhnlhxksokkerkos
#   supabase secrets set GOOGLE_CX=yyy --project-ref iyvavhnlhxksokkerkos
#   supabase functions deploy product-image-search --project-ref iyvavhnlhxksokkerkos
#
# DÉVELOPPEMENT LOCAL (optionnel, si tu lances la fonction en local) :
#   supabase functions serve product-image-search --env-file .env
# (et tu copies ce fichier en .env avec tes vraies clés — .env est gitignored)
#
# Obtenir les clés Google :
#   - GOOGLE_API_KEY : https://console.cloud.google.com/apis/credentials
#     → activer "Custom Search API" puis créer une API key
#   - GOOGLE_CX     : https://programmablesearchengine.google.com/
#     → créer un moteur de recherche, activer "Recherche d'images" et
#       "Recherche sur tout le Web", récupérer le "ID du moteur de recherche"
#   - Quota gratuit : 100 requêtes/jour
# =============================================================================

GOOGLE_API_KEY=
GOOGLE_CX=
